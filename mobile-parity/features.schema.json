{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCGer cross-platform feature parity contract",
  "type": "object",
  "required": ["schemaVersion", "platforms", "features", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "policy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
          "title": { "type": "string", "minLength": 1 },
          "policy": { "enum": ["parity", "track"] },
          "flow": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": { "$ref": "#/$defs/platformState" }
      }
    },
    "controls": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "testEvidence": {
      "type": "object",
      "required": ["runner", "id"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "required": ["reason", "owner", "expires"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "platformState": {
      "type": "object",
      "required": ["status", "sources"],
      "properties": {
        "status": { "enum": ["implemented", "partial", "planned", "unavailable", "not_applicable", "waived"] },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/testEvidence" }, "uniqueItems": true },
        "waiver": { "$ref": "#/$defs/waiver" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "waived" } }, "required": ["status"] },
          "then": { "required": ["waiver"] },
          "else": { "not": { "required": ["waiver"] } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
