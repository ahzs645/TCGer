{
  "name": "@tcg/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "build:hashes": "tsx src/scripts/build-card-hashes.ts",
    "backfill:hash-features": "tsx src/scripts/backfill-card-hash-features.ts",
    "scan:video": "tsx src/scripts/scan-video.ts",
    "eval:video-stream": "tsx src/scripts/eval-video-stream.ts",
    "scan:video-live-stream": "tsx src/scripts/live-video-stream-scan.ts",
    "probe:video-frame": "tsx src/scripts/probe-video-frame.ts",
    "probe:detector-handoff": "tsx src/scripts/probe-detector-handoff.ts",
    "build:artwork": "tsx src/scripts/build-artwork-fingerprints.ts",
    "build:embedding-assets": "python3 scripts/export-external-embedding-assets.py",
    "start": "tsx src/server.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest --passWithNoTests",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@prisma/client": "~6.19.3",
    "@tcg/api-types": "*",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "bcrypt": "^6.0.0",
    "better-auth": "~1.6.33",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "onnxruntime-node": "~1.30.0",
    "pino": "^8.16.1",
    "pino-http": "^8.5.0",
    "sharp": "~0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.8.10",
    "@types/sharp": "^0.31.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.3",
    "prisma": "~6.19.3",
    "ts-jest": "^29.4.14",
    "typescript": "^5.2.2",
    "@tensorflow/tfjs": "^4.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
