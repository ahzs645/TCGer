{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-scanner-bundle.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tcger-scanner-bundle-v1"
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "index": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "url",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "url",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "gameId",
    "index",
    "model"
  ],
  "additionalProperties": false
}
