{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcger.app/schemas/game-package-manifest/v1",
  "title": "TCGer GamePackageManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageVersion",
    "publishedAt",
    "game",
    "publisher",
    "catalog"
  ],
  "properties": {
    "schema": { "const": "https://tcger.app/schemas/game-package-manifest/v1" },
    "packageId": { "$ref": "#/$defs/id" },
    "packageVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "manifestUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "releaseNotes": { "type": "string", "maxLength": 2000 }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "shortName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "description": { "type": "string", "maxLength": 500 },
        "homepage": { "type": "string", "format": "uri" },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "homepage": { "type": "string", "format": "uri" },
        "signingKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "algorithm", "publicKey"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "algorithm": { "const": "ed25519" },
            "publicKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "url"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "$ref": "#/$defs/id" },
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "asset", "cardCount"],
      "properties": {
        "schema": { "const": "tcger-catalog-v1" },
        "asset": { "$ref": "#/$defs/asset" },
        "cardCount": { "type": "integer", "minimum": 0 },
        "setCount": { "type": "integer", "minimum": 0 }
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/filter" },
      "default": []
    },
    "definition": { "$ref": "#/$defs/gameDefinition" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": { "$ref": "#/$defs/runtimeAsset" },
        "ios": { "$ref": "#/$defs/runtimeAsset" },
        "android": { "$ref": "#/$defs/runtimeAsset" }
      }
    },
    "offlinePacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "manifest"],
      "properties": {
        "schema": { "const": "tcger-pack-library-v1" },
        "manifest": { "$ref": "#/$defs/asset" }
      }
    },
    "sealedProducts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "asset", "productCount"],
      "properties": {
        "schema": { "const": "tcger-sealed-catalog-v1" },
        "asset": { "$ref": "#/$defs/asset" },
        "productCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["signature"] },
      "then": {
        "properties": { "publisher": { "required": ["signingKey"] } }
      }
    },
    {
      "if": {
        "properties": {
          "publisher": { "required": ["signingKey"] }
        }
      },
      "then": { "required": ["signature"] }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "property": {
      "type": "string",
      "pattern": "^(id|name|setCode|collectorNumber|rarity|artist|type|category|releasedAt|attributes\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)$"
    },
    "definitionProperty": {
      "type": "string",
      "pattern": "^(name|setCode|setName|collectorNumber|rarity|releasedAt|language|artist|supertype|regulationMark|sanctionedPlayLegal|quantity|dexEntries\\.number|formatLegality\\.(standard|expanded|unlimited)|attributes\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*|copies\\.(condition|language|finishCode|finishLabel|edition|stamp))$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "property", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "property": { "$ref": "#/$defs/property" },
        "help": { "type": "string", "maxLength": 240 },
        "type": {
          "enum": ["select", "multiSelect", "numberRange", "boolean", "text"]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/option" }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "trueLabel": { "type": "string", "maxLength": 80 },
        "falseLabel": { "type": "string", "maxLength": 80 },
        "mode": { "enum": ["contains", "equals"] },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["select", "multiSelect"] } }
          },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "numberRange" } } },
          "then": { "required": ["min", "max"] }
        }
      ]
    },
    "definitionFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "property", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "property": { "$ref": "#/$defs/definitionProperty" },
        "help": { "type": "string", "maxLength": 240 },
        "type": {
          "enum": ["select", "multiSelect", "numberRange", "boolean", "text"]
        },
        "options": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/option" }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "trueLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "falseLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "mode": { "enum": ["contains", "equals"] },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "numberRange" } } },
          "then": { "required": ["min", "max"] }
        }
      ]
    },
    "runtimeAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "manifest"],
      "properties": {
        "runtime": { "const": "tcger-arcface-v1" },
        "manifest": { "$ref": "#/$defs/asset" }
      }
    },
    "gameDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "collection", "search"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shortLabel": { "type": "string", "minLength": 1, "maxLength": 24 },
        "aliases": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/id" }
        },
        "formats": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "physical": { "type": "boolean", "default": true }
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "iconUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "cardBackUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "interfaces": { "$ref": "#/$defs/interfaces" },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityModes", "defaultIdentityMode", "facets"],
          "properties": {
            "identityModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "description", "key"],
                "properties": {
                  "id": { "enum": ["consolidated", "collector"] },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "key": { "enum": ["baseExternalId", "printingKey"] }
                }
              }
            },
            "defaultIdentityMode": { "enum": ["consolidated", "collector"] },
            "facets": {
              "type": "array",
              "maxItems": 24,
              "items": { "$ref": "#/$defs/definitionFacet" }
            }
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["facets"],
          "properties": {
            "facets": {
              "type": "array",
              "maxItems": 24,
              "items": { "$ref": "#/$defs/definitionFacet" }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": { "type": "boolean", "default": true },
        "collection": { "type": "boolean", "default": true },
        "sets": { "type": "boolean", "default": true },
        "wishlists": { "type": "boolean", "default": true },
        "decks": { "type": "boolean", "default": false },
        "pricing": { "type": "boolean", "default": false },
        "sealedProducts": { "type": "boolean", "default": false },
        "scanner": { "type": "boolean", "default": false },
        "packOpening": { "type": "boolean", "default": false },
        "features": {
          "type": "array",
          "maxItems": 32,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "default": 1
              }
            }
          }
        }
      }
    }
  }
}
