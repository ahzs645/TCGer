{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcger.app/schemas/card-geometry-archive-corner-labels/v1",
  "title": "TCGer archive corner labels v1",
  "description": "Human four-corner labels for whole-card annotations of canonical archive records. Each labeled instance names the canonical annotation it refines by index, so the importer attaches human corners to the same target it would otherwise import box-only. Labels are bound to the canonical corpus bytes and to the image bytes they were drawn on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalCorpusSha256", "frames"],
  "properties": {
    "schema": {
      "const": "https://tcger.app/schemas/card-geometry-archive-corner-labels/v1"
    },
    "canonicalCorpusSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonicalRecordId", "imageSha256", "reviewer", "labeledAt", "instances"],
        "properties": {
          "canonicalRecordId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "imageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewer": { "type": "string", "minLength": 1, "maxLength": 120 },
          "labeledAt": { "type": "string", "minLength": 1, "maxLength": 64 },
          "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceAnnotationIndex", "corners", "cornerVisibility", "orientationKnown"],
              "properties": {
                "sourceAnnotationIndex": { "type": "integer", "minimum": 0 },
                "orientationKnown": { "type": "boolean" },
                "corners": {
                  "description": "Normalized TL, TR, BR, BL corners in the source image; values may lie slightly outside [0, 1] for corners beyond the frame.",
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [{ "type": "number" }, { "type": "number" }],
                    "items": false
                  }
                },
                "cornerVisibility": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "enum": ["visible", "occluded", "outsideFrame"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
