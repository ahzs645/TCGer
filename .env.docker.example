# Copy to .env.docker and adjust secrets before running docker-compose
POSTGRES_DB=tcg_collection
POSTGRES_USER=tcguser
POSTGRES_PASSWORD=tcgpassword
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TCGER_BRIDGE_SECRET=replace-with-a-different-32-character-random-secret

# Production self-hosted Convex only. Generate INSTANCE_SECRET with
# `openssl rand -hex 32`; never reuse or rotate it without a migration plan.
INSTANCE_NAME=tcger-production
INSTANCE_SECRET=replace-with-64-character-lowercase-hex-instance-secret

# Fill this in after the first backend boot by running generate_admin_key.sh.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Pin this to an immutable release tag/digest after qualification. `latest`
# matches Convex's official self-hosted Compose example.
CONVEX_BACKEND_TAG=latest

# Production deployments with an external reverse proxy should override these
# with the two browser-reachable HTTPS origins. Convex ports remain unpublished.
# CONVEX_CLOUD_ORIGIN=https://convex-api.example.com
# CONVEX_SITE_ORIGIN=https://convex-site.example.com
# NEXT_PUBLIC_CONVEX_URL=https://convex-api.example.com
# NEXT_PUBLIC_CONVEX_SITE_URL=https://convex-site.example.com

SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
# Paid JustTCG key used only by the server for commercial card pricing.
JUSTTCG_API_KEY=
JUSTTCG_API_BASE_URL=https://api.justtcg.com/v1
# Tracked-card market quotes stay fresh for 12 hours; manual refreshes are rate-limited for 5 minutes.
PRICE_REFRESH_INTERVAL_MS=43200000
PRICE_FORCE_REFRESH_COOLDOWN_MS=300000
APP_PORT=3003
SITE_URL=http://localhost:3003
BETTER_AUTH_URL=http://localhost:3003/api/auth
# Production HTTPS deployments may also set these explicitly.
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_USE_SECURE_COOKIES=
APP_ORIGIN=http://localhost:3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_API_BASE_URL=http://localhost:3003/api
BACKEND_API_ORIGIN=http://backend:3000
NEXT_PUBLIC_CATALOG_BASE_URL=https://assets.tcger.ahmadjalil.com/catalogs

# Card-scanner admission controls. These defaults are per backend process;
# production clusters should enforce an additional distributed/edge limit.
CARD_SCAN_RATE_WINDOW_MS=60000
CARD_SCAN_RATE_LIMIT=20
CARD_SCAN_MAX_CONCURRENT=4
CARD_SCAN_MAX_CONCURRENT_PER_USER=1
CARD_SCAN_MAX_PIXELS=25000000

# Optional; enables Dragon Ball Super card search
APITCG_API_KEY=

# Optional host port overrides when defaults are already in use
BACKEND_PORT=3004
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
