{
  "name": "@tcg/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync-pack-assets && next dev",
    "dev:host": "npm run sync-pack-assets && next dev --port 3003",
    "prebuild": "npm run sync-pack-assets && npm --prefix ../packages/api-types run build",
    "build": "next build",
    "prebuild:demo": "npm run sync-pack-assets && npm --prefix ../packages/api-types run build && rm -rf app/api",
    "build:demo": "DEMO_EXPORT=true next build",
    "postbuild:demo": "git checkout -- app/api",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/lib/app-routes.test.ts src/lib/copy-labels.test.ts src/lib/demo-activity.test.ts src/lib/online-codes.test.ts src/lib/storage/portable-rules.test.ts src/lib/storage/legacy-collection-rows.test.ts src/lib/storage/legacy-portfolio-rows.test.ts src/lib/api/demo-adapter.test.ts src/lib/api/collection-semantics.test.ts src/lib/catalog/catalog-search.test.ts src/lib/data/demo-cards.test.ts src/lib/achievements/achievements.test.ts src/lib/pokedex/pokedex.test.ts src/lib/currency/exchange-rates.test.ts src/lib/pricing/collection-price-lots.test.ts src/lib/pricing/purchase-performance.test.ts src/stores/demo-store.test.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "sync-pack-assets": "node ../packages/pack-core/scripts/sync-assets.mjs public"
  },
  "dependencies": {
