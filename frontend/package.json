    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.43.0",
    "date-fns": "^2.30.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.31.0",
