*.profdata

# Local research artifacts
research/
/*-decompiled/
.artifacts/huggingface/

# Local recognition eval data (real user captures — do not commit)
backend/eval-data/
mobile-apps/ios/scripts/.venv-coreml/
mobile-apps/ios/TCGer/build/
mobile-apps/ios/scripts/__pycache__/

# Generated web scan-index artifacts (large, reproducible, CDN-hosted — see
# frontend/public/scan-index/README.md). The iOS ScanIndex assets are TRACKED
# in git deliberately: Xcode Cloud builds from a fresh clone, so gitignored
# assets would ship a scanner with no model/index. See
# docs/scanner-asset-packaging.md.
frontend/public/scan-index/*.json
frontend/public/scan-index/*.bin
frontend/public/scan-index/*.onnx

# Generated offline catalog packs (READMEs remain tracked).
data/catalog/
frontend/public/catalog/*
!frontend/public/catalog/README.md
mobile-apps/ios/TCGer/TCGer/Resources/Catalogs/*
!mobile-apps/ios/TCGer/TCGer/Resources/Catalogs/README.md

# Booster pack mesh and cover sheets, copied out of the packages/pack-core
# submodule by its sync-assets script — neither bundler serves files from a
# submodule, so the copy is generated, not tracked.
frontend/public/pack/

# Published pack artwork is fetched from the R2 manifest. The embedded iOS
# fallback may keep generic pack resources, but never projected cover images.
mobile-apps/ios/TCGer/TCGer/Resources/PackOpening.bundle/pack/covers/
mobile-apps/ios/TCGer/TCGer/Resources/PackOpening.bundle/pack/bases/
mobile-apps/ios/TCGer/TCGer/Resources/PackOpening.bundle/pack/decals/
